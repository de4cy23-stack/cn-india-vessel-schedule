# Only configure credentials/endpoints you are authorized to use.
# Never commit real API keys, client secrets or bearer tokens.

REQUEST_TIMEOUT_SECONDS=25

# Common auth fields supported per carrier:
# *_API_KEY / *_API_KEY_HEADER
# *_BEARER_TOKEN
# *_OAUTH_TOKEN_URL / *_OAUTH_CLIENT_ID / *_OAUTH_CLIENT_SECRET / *_OAUTH_SCOPE

# Maersk Commercial Schedules / Ocean Products
# Official base: https://api.maersk.com
# Public Point-to-Point uses Consumer-Key and does not require OAuth2.
MAERSK_ENABLED=false
MAERSK_BASE_URL=https://api.maersk.com
MAERSK_POINT_TO_POINT_PATH=/products/ocean-products
MAERSK_API_KEY=
MAERSK_API_KEY_HEADER=Consumer-Key
MAERSK_ORIGIN_PARAM=origin
MAERSK_DESTINATION_PARAM=destination
MAERSK_DATE_FROM_PARAM=
MAERSK_DATE_TO_PARAM=
MAERSK_CARRIER_CODE=MAEU
MAERSK_BEARER_TOKEN=
MAERSK_OAUTH_TOKEN_URL=
MAERSK_OAUTH_CLIENT_ID=
MAERSK_OAUTH_CLIENT_SECRET=
MAERSK_OAUTH_SCOPE=

# CMA CGM DCSA Commercial Schedules
# Production base: https://apis.cma-cgm.net
# Public APIs can use KeyId. Private APIs use OAuth2 Client Credentials.
CMACGM_ENABLED=false
CMACGM_BASE_URL=https://apis.cma-cgm.net
CMACGM_POINT_TO_POINT_PATH=/v1/point-to-point-routes
CMACGM_API_KEY=
CMACGM_API_KEY_HEADER=KeyId
CMACGM_ORIGIN_PARAM=placeOfReceipt
CMACGM_DESTINATION_PARAM=placeOfDelivery
CMACGM_DATE_FROM_PARAM=departureStartDate
CMACGM_DATE_TO_PARAM=departureEndDate
CMACGM_BEARER_TOKEN=
CMACGM_OAUTH_TOKEN_URL=https://auth.cma-cgm.com/as/token.oauth2
CMACGM_OAUTH_CLIENT_ID=
CMACGM_OAUTH_CLIENT_SECRET=
CMACGM_OAUTH_SCOPE=

# ONE - subscribe through the ONE Developer Portal.
# Its Point-to-Point Schedule product is DCSA compliant.
ONE_ENABLED=false
ONE_BASE_URL=
ONE_POINT_TO_POINT_PATH=
ONE_API_KEY=
ONE_API_KEY_HEADER=Authorization
ONE_ORIGIN_PARAM=placeOfReceipt
ONE_DESTINATION_PARAM=placeOfDelivery
ONE_DATE_FROM_PARAM=departureStartDate
ONE_DATE_TO_PARAM=departureEndDate
ONE_BEARER_TOKEN=
ONE_OAUTH_TOKEN_URL=
ONE_OAUTH_CLIENT_ID=
ONE_OAUTH_CLIENT_SECRET=
ONE_OAUTH_SCOPE=

# HMM - subscribe through the HMM API Portal.
# HMM publishes Port-to-Port Schedule in its Schedule API package.
HMM_ENABLED=false
HMM_BASE_URL=
HMM_POINT_TO_POINT_PATH=
HMM_API_KEY=
HMM_API_KEY_HEADER=Authorization
HMM_ORIGIN_PARAM=placeOfReceipt
HMM_DESTINATION_PARAM=placeOfDelivery
HMM_DATE_FROM_PARAM=departureStartDate
HMM_DATE_TO_PARAM=departureEndDate
HMM_BEARER_TOKEN=
HMM_OAUTH_TOKEN_URL=
HMM_OAUTH_CLIENT_ID=
HMM_OAUTH_CLIENT_SECRET=
HMM_OAUTH_SCOPE=

# Hapag-Lloyd - fill values from its API Portal subscription.
HAPAG_ENABLED=false
HAPAG_BASE_URL=
HAPAG_POINT_TO_POINT_PATH=
HAPAG_API_KEY=
HAPAG_API_KEY_HEADER=Authorization
HAPAG_ORIGIN_PARAM=placeOfReceipt
HAPAG_DESTINATION_PARAM=placeOfDelivery
HAPAG_DATE_FROM_PARAM=departureStartDate
HAPAG_DATE_TO_PARAM=departureEndDate
HAPAG_BEARER_TOKEN=
HAPAG_OAUTH_TOKEN_URL=
HAPAG_OAUTH_CLIENT_ID=
HAPAG_OAUTH_CLIENT_SECRET=
HAPAG_OAUTH_SCOPE=

# MSC - Point-to-Point Commercial Schedules is live and DCSA compliant.
# Supply the Developer Portal base URL and credentials issued to your integration.
MSC_ENABLED=false
MSC_BASE_URL=
MSC_POINT_TO_POINT_PATH=/v1/point-to-point-routes
MSC_API_KEY=
MSC_API_KEY_HEADER=Authorization
MSC_ORIGIN_PARAM=placeOfReceipt
MSC_DESTINATION_PARAM=placeOfDelivery
MSC_DATE_FROM_PARAM=departureStartDate
MSC_DATE_TO_PARAM=departureEndDate
MSC_BEARER_TOKEN=
MSC_OAUTH_TOKEN_URL=
MSC_OAUTH_CLIENT_ID=
MSC_OAUTH_CLIENT_SECRET=
MSC_OAUTH_SCOPE=

# Evergreen - DCSA lists Commercial Schedules 1.0 as implemented.
# Supply the official API Portal base URL and credentials available to your account.
EVERGREEN_ENABLED=false
EVERGREEN_BASE_URL=
EVERGREEN_POINT_TO_POINT_PATH=/v1/point-to-point-routes
EVERGREEN_API_KEY=
EVERGREEN_API_KEY_HEADER=Authorization
EVERGREEN_ORIGIN_PARAM=placeOfReceipt
EVERGREEN_DESTINATION_PARAM=placeOfDelivery
EVERGREEN_DATE_FROM_PARAM=departureStartDate
EVERGREEN_DATE_TO_PARAM=departureEndDate
EVERGREEN_BEARER_TOKEN=
EVERGREEN_OAUTH_TOKEN_URL=
EVERGREEN_OAUTH_CLIENT_ID=
EVERGREEN_OAUTH_CLIENT_SECRET=
EVERGREEN_OAUTH_SCOPE=
